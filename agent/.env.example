# Environment is split by layer and real secret values should live outside
# this workspace.
#
# Copy the layer examples into:
# - $SECRETS_DIR/agent_layer.env
# - $SECRETS_DIR/mcp_layer.env
# - $SECRETS_DIR/frontend_layer.env
#
# Set SECRETS_DIR before running Docker Compose.
SECRETS_DIR=/absolute/path/to/external/secrets
